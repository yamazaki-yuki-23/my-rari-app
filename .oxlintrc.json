{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": "warn",
    "no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": ["*.config.js", "*.config.mjs", "*.config.ts", "*.config.mts", "vite.config.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
